# Royal Academy Production Environment Variables

# Primary Domain
PRIMARY_DOMAIN="https://www.royalacademy.pk"

# Server Port & Mode
PORT=3000
NODE_ENV="production"

# Database Configuration (PostgreSQL connection string for Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/royal_academy?schema=public"

# JWT Secret Key for Admin Authentication
JWT_SECRET="royal_academy_secure_jwt_secret_2026_faisalabad"

# Gemini AI API Key (Optional - Graceful fallback available)
GEMINI_API_KEY=""

# Google Sheets Webhook Integration (Recommended - Paste Google Apps Script Web App URL here)
GOOGLE_SHEETS_WEBHOOK_URL=""

# Google Sheets API (Alternative method using Service Account)
GOOGLE_SHEET_ID=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Google Maps Platform (Optional - JavaScript API Key)
GOOGLE_MAPS_API_KEY=""

# SMTP Email Configuration (For notifications or forgot password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Default Administrator Setup
ADMIN_EMAIL="ayeshawadood02@gmail.com"
ADMIN_PASSWORD=""
